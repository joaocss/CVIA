# Copie para .env e ajuste. Todas as variaveis sao opcionais (ha padroes).

# Provedores de IA: mock (offline) | local (sentence-transformers) | openai
CVIA_EMBEDDING_PROVEDOR=mock
CVIA_LLM_PROVEDOR=mock

# Necessario apenas se usar provedor openai
# OPENAI_API_KEY=sk-...

# Modelos (opcional)
# CVIA_MODELO_EMBEDDING_OPENAI=text-embedding-3-small
# CVIA_MODELO_LLM_OPENAI=gpt-4o-mini
# CVIA_MODELO_EMBEDDING_LOCAL=paraphrase-multilingual-MiniLM-L12-v2

# Parametros do RAG (opcional)
# CVIA_TOP_K=4
# CVIA_LIMIAR_GROUNDING=0.18
# CVIA_CHUNK_TAMANHO=900

# Supabase/Postgres (opcional, para persistir o indice online em vez do
# arquivo local dados/indice/vetores.npy). Tambem usado pelo log de
# interacoes do painel /admin (cvia_interacoes), independente do
# CVIA_REPOSITORIO escolhido.
# DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
# CVIA_REPOSITORIO=local

# Painel de gestor (/admin) — uso, guardrails e heuristica de fidelidade.
# Sem token = painel desabilitado. Gere um valor forte, ex:
# python -c "import secrets; print(secrets.token_urlsafe(24))"
# CVIA_ADMIN_TOKEN=
# Roda uma 2a chamada de LLM (barata) checando se a resposta se sustenta
# nas fontes. Desliga se quiser cortar custo/latencia.
# CVIA_VERIFICAR_FIDELIDADE=true
